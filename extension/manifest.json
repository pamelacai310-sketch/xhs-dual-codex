{
  "manifest_version": 3,
  "name": "小红书收藏＋点赞本地导出",
  "short_name": "小红书本地导出",
  "description": "在本机采集自己账号可见的收藏与赞过列表，导出后生成去敏的 Codex 学习项目。",
  "version": "1.0.1",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.xiaohongshu.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "小红书收藏＋点赞本地导出",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "src/injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "src/lib.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
